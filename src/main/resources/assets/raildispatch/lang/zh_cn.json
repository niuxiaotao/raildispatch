{
  "itemGroup.raildispatch": "机械动力航空学：轨道调度",

  "block.raildispatch.physics_cab": "物理驾驶台",
  "block.raildispatch.physics_cab.tooltip.summary": "读取 _机械动力时刻表_，监视 _铁路信号机_，驱动 _物理转向架_。",
  "block.raildispatch.physics_cab.tooltip.condition1": "放入时刻表时",
  "block.raildispatch.physics_cab.tooltip.behaviour1": "执行时刻表条目：_停车_、_等待_、_连挂车辆_、_按地址调车_。",
  "block.raildispatch.physics_cab.tooltip.condition2": "前方信号机为红灯时",
  "block.raildispatch.physics_cab.tooltip.behaviour2": "在信号机前制动停车，并向地面调度层 _请求进路_。",

  "block.raildispatch.autopilot_console": "自动驾驶台",
  "block.raildispatch.autopilot_console.tooltip.summary": "输入目的地，让车辆沿 _机械动力轨道图_ 自动行驶：自动扳 _道岔_、按 _信号机_ 停车、按 _PID_ 调速。",
  "block.raildispatch.autopilot_console.tooltip.condition1": "空手右键",
  "block.raildispatch.autopilot_console.tooltip.behaviour1": "输入车站告示牌、铭牌或车辆标签，按「启程」开始自动行驶。",
  "block.raildispatch.autopilot_console.tooltip.condition2": "通过 Drive By Wire 接线时",
  "block.raildispatch.autopilot_console.tooltip.behaviour2": "本方块输出 _前进_、_制动_ 两个通道（0-15）；它只朝屏幕背面（操作员看屏幕的方向）行驶，没有后退通道。",

  "block.raildispatch.reverser": "换向器",
  "block.raildispatch.reverser.tooltip.summary": "驱动物理转向架的转向装置，可由 _物理驾驶台_ 或 _红石_ 控制。",
  "block.raildispatch.reverser.tooltip.condition1": "被红石充能时",
  "block.raildispatch.reverser.tooltip.behaviour1": "转向角跟随模拟信号强度（0-15）。",
  "block.raildispatch.dispatch_center": "调度中心",
  "block.raildispatch.dispatch_center.tooltip.summary": "在 _机械动力轨道图_ 上集中计算进路，并扳动地面 _道岔_。",
  "block.raildispatch.dispatch_center.tooltip.condition1": "手持物品先右键铁轨，再找位置放下",
  "block.raildispatch.dispatch_center.tooltip.behaviour1": "和 _列车信号机_ 一样先选中那条轨道；调度中心由此知道自己管辖哪条铁路。",
  "block.raildispatch.dispatch_center.tooltip.condition2": "有驾驶台在范围内时",
  "block.raildispatch.dispatch_center.tooltip.behaviour2": "按车锁定区间、锁闭道岔，车辆出清后自动解锁进路。",
  "raildispatch.dispatch_center.track": "已锁定轨道 %s",

  "block.raildispatch.address_plate": "地址牌",
  "block.raildispatch.address_plate.tooltip.summary": "标记调车线的 _去向_（驼峰调车场分选）。",
  "block.raildispatch.address_plate.tooltip.condition1": "手持地址标签右键",
  "block.raildispatch.address_plate.tooltip.behaviour1": "把该地址登记为这条线路的去向编码。",
  "block.raildispatch.retarder": "减速顶",
  "block.raildispatch.retarder.tooltip.summary": "让经过的自由溜放车辆减速。_红石信号强度_（0-15）就是制动力。",
  "block.raildispatch.retarder.tooltip.condition1": "手持物品先右键铁轨，再找位置放下方块",
  "block.raildispatch.retarder.tooltip.behaviour1": "像车站/信号机一样绑定到该轨道点；红石 0 关闭、15 全力制动，只对自由溜放车辆起作用。",
  "block.raildispatch.yard_terminal": "Yard Terminal",
